#: cli.py:42
msgid ""
"Hex game input syntax help:\n"
"    [letter][number]: Input next move to play (example: 'a5').\n"
"    'u/undo':         Undo the two players last moves.\n"
"    'r/redo':         Redo the two players last undone moves.\n"
"    'h/help':         Display program help\".\n"
"    'd/display':      Display current game board.\n"
"    'restart':        Restart current game (with the same configuration).\n"
"    'l/load' [FILE]:  Load game in specified file name (not implemented yet).\n"
"    's/save' [FILE]:  Save current game in specified file name (not implemented yet).\n"
"    'g/give up'       Give up current game (current player loses).\n"
"    'q/quit':         Exit program."
msgstr ""

